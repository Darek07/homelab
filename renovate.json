{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "registryAliases": {
    "lscr.io": "ghcr.io"
  },
  "packageRules": [
    {
      "groupName": "fluxcd",
      "matchPackageNames": ["ghcr.io/fluxcd/*", "fluxcd/flux2"],
      "separateMajorMinor": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/*"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "Darek07",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "assignees": [
    "Darek07"
  ]

}
