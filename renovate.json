{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "registryAliases": {
    "lscr.io": "ghcr.io"
  },
  "packageRules": [
    {
      "groupName": "fluxcd",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/fluxcd/*"],
      "separateMajorMinor": false
    }
  ],
  "assignees": [
    "Darek07"
  ]
}

